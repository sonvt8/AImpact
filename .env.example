# Docker DEV không cần tạo .env: Compose tự dùng mặc định an toàn cho local.
# PRODUCTION BẮT BUỘC đặt tường minh 4 biến đầu tiên; không commit file .env.
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
FRONTEND_ORIGIN=

JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=7
APP_PORT=8000

# Thư mục HOST chứa cc.vi.300.bin; dùng đường dẫn tuyệt đối nếu model nằm ngoài ./models.
AIMPACT_MODELS_DIR=./models
# Các thư mục HOST writable được bind-mount bởi Docker Compose.
AIMPACT_DATA_DIR=./data
AIMPACT_HISTORY_DIR=./history
AIMPACT_DOCUMENTS_DIR=./documents

DATA_DIR=./data
HISTORY_DIR=./history
DOCUMENTS_DIR=./documents
MODEL_PATH=./models/cc.vi.300.bin
STATS_WORKBOOK=./project_agent/Phu luc 1.xlsx
DATABASE_PATH=./data/app.db
PROVIDERS_STATE_PATH=./data/providers.state.json
FRONTEND_DIST=./web/dist
SIMILARITY_THRESHOLD=0.78
LLM_TIMEOUT=60
MAX_UPLOAD_MB=50
NROUTER_API_KEY=
# Docker Compose: để trống để dùng http://host.docker.internal:20128/v1.
# Chạy DEV không Docker: đặt http://127.0.0.1:20128/v1.
NROUTER_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
XAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
XAI_API_KEY=
