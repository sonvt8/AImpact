# Required UI password (no default)
APP_PASSWORD=

# Relative project paths
DATA_DIR=data
HISTORY_DIR=history
DOCUMENTS_DIR=documents
MODEL_PATH=./models/cc.vi.300.bin

# Retrieval threshold
SIMILARITY_THRESHOLD=0.5

# OpenAI-compatible backend (for example, 9Router)
LLM_BACKEND=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_SKIP_INTERNET_CHECK=true

# Ollama settings; switch with: LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding identity and optional domain profile hook
EMBEDDING_MODEL_ID=fasttext-cc.vi.300-v1
DOMAIN_PROFILE=
